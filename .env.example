# Port for the server (Render automatically sets PORT)
PORT=3000

# Optional Database URL (PostgreSQL)
# When provided, the server uses PostgreSQL. If omitted, it uses high-speed SQLite with WAL mode.
# Example: postgresql://user:password@host:5432/easymart_db?sslmode=require
DATABASE_URL=

# Optional API Secret Key for securing endpoints
# If set, clients must pass this via 'Authorization: Bearer <KEY>' or 'x-api-key: <KEY>'
API_SECRET_KEY=

# Node Environment
NODE_ENV=production
